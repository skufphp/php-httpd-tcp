# ========================================
# PHP-Httpd-TCP Environment Configuration
# ========================================

# MySQL Root Password (используется docker-compose.yml)
MYSQL_ROOT_PASSWORD=root

# phpMyAdmin Configuration (используется docker-compose.yml)
PMA_HOST=mysql-httpd-tcp

# Ports Configuration
HTTPD_PORT=80
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080

# Xdebug (optional; enabled via docker-compose.xdebug.yml by default when using make xdebug-up)
# Set these only if you want to enable Xdebug without the overlay compose file
XDEBUG_MODE=
XDEBUG_START=
XDEBUG_CLIENT_HOST=host.docker.internal

# MySQL Database Configuration (используется только PHP приложением)
# База и пользователь создаются вручную через PHPStorm или init.sql
#MYSQL_HOST=mysql-httpd-tcp
#MYSQL_PORT=3306
#MYSQL_DATABASE=mysql-httpd-tcp-db
#MYSQL_USER=database-user
#MYSQL_PASSWORD=database-user-password

#-- Создать пользователя
#CREATE USER 'database-user'@'%' IDENTIFIED BY 'надёжный_пароль';
#
#-- Выдать права на конкретную БД
#GRANT SELECT, INSERT, UPDATE, DELETE ON `mysql-httpd-tcp-db`.* TO 'database-user'@'%';
#
#-- Применить
#FLUSH PRIVILEGES;